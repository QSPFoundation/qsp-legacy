// Ported from qsp-wasm-engine tests/engine/variables.test.ts
// qsp-legacy (QSP 5.7) has no multiple assignment, LOCAL and tuples, the tests using them are skipped

@test default number value
@expect not_defined => 0

@test default string value
@expect $not_defined => ''

@test variables are case insensitive
@src
money = 100 & MONEY += 1
@run
@expect MoNeY => 101

@test LET assignment
@src
LET money = 100
@run
@expect money => 100

@test SET assignment
@src
SET money = 100
@run
@expect money => 100

@test assignment
@src
money = 100
@run
@expect money => 100

@test assignment to array item by numeric index
@src
money[2] = 100
@run
@expect money[0] => 0
@expect money[1] => 0
@expect money[2] => 100

@test assignment to array item by string index
@src
money['key'] = 100
@run
@expect money['key'] => 100

@test multi assignment
@skip multiple assignment is not supported by qsp-legacy (QSP 5.7)

@test multi assignment with explicit tuple
@skip multiple assignment is not supported by qsp-legacy (QSP 5.7)


// Ported from qsp-wasm-engine tests/engine/arrays.test.ts
// In qsp-legacy the start index is the first argument of ARRPOS and ARRCOMP

// Every item keeps both a number and a string in qsp-legacy, assigning one doesn't clear the other
@test overriding string value with number
@src

$arr[1] = 'test'
arr[1] = 1

@run
@expect $arr[1] => 'test'
@expect arr[1] => 1

// Every item keeps both a number and a string in qsp-legacy, assigning one doesn't clear the other
@test overriding number value with string
@src

arr[1] = 1
$arr[1] = 'test'

@run
@expect $arr[1] => 'test'
@expect arr[1] => 1

@test last element assignment
@src

$objs[] = 'Напильник'
$objs[] = 'Топор'
$objs[] = 'Доска'

@run
@expect $objs[0] => 'Напильник'
@expect $objs[1] => 'Топор'
@expect $objs[2] => 'Доска'

@test last element read
@src

$objs[] = 'Напильник'
$objs[] = 'Топор'
$objs[] = 'Доска'
$a = $objs[]

@run
@expect $a => 'Доска'

@test string index
@src
любимое_число['Алексей'] = 5 & x = любимое_число['Алексей']
@run
@expect любимое_число['Алексей'] => 5
@expect x => 5

@test killvar all variables
@src
a = 1 & $b = "xx"
@run
@expect a => 1
@expect $b => 'xx'
@exec killvar
@expect a => 0
@expect $b => ''

@test killvar whole number array
@src
a[0] = 1 & a[1] = 2
@run
@expect a[0] => 1
@expect a[1] => 2
@exec killvar 'a'
@expect a[0] => 0
@expect a[1] => 0

@test killvar whole string array
@src
$a[0] = "zz" & $a[1] = "xx"
@run
@expect $a[0] => 'zz'
@expect $a[1] => 'xx'
@exec killvar 'a'
@expect $a[0] => ''
@expect $a[1] => ''

@test killvar array index in numeric array
@src
a[0] = 1 & a[1] = 2 & a[2] = 3
@run
@exec killvar 'a', 1
@expect a[0] => 1
@expect a[1] => 3
@expect a[2] => 0

@test killvar array index in string array
@src
$a[0] = "aa" & $a[1] = "bb" & $a[2] = "cc"
@run
@exec killvar 'a', 1
@expect $a[0] => 'aa'
@expect $a[1] => 'cc'
@expect $a[2] => ''

// KILLVAR takes only a numeric index in qsp-legacy
@test killvar array key in number array
@src
a['test'] = 1 & a['other'] = 2
@run
@expect a['test'] => 1
@expect a['other'] => 2
@exec killvar 'a', 'test'
@expect error TYPEMISMATCH

// KILLVAR takes only a numeric index in qsp-legacy
@test killvar array key in string array
@src
$a['test'] = "aa" & $a['other'] = "zz"
@run
@exec killvar 'a', 'test'
@expect error TYPEMISMATCH

@test killall clears all variables
@src
a = 1 & $b = "xx"
@run
@exec killall
@expect a => 0
@expect $b => ''

@test copyarr whole numeric array
@src
a[0] = 1 & a[1] = 2 & a[2] = 3
@run
@expect b[0] => 0
@exec copyarr 'b', 'a'
@expect a[0] => 1
@expect a[2] => 3
@expect b[0] => 1
@expect b[1] => 2
@expect b[2] => 3

@test copyarr whole string array
@src
$a[0] = "aa" & $a[1] = "bb" & $a[2] = "cc"
@run
@exec copyarr 'b', 'a'
@expect $a[0] => 'aa'
@expect $b[0] => 'aa'
@expect $b[1] => 'bb'
@expect $b[2] => 'cc'

@test copyarr with start index in numeric array
@src
a[0] = 1 & a[1] = 2 & a[2] = 3
@run
@exec copyarr 'b', 'a', 1
@expect b[0] => 2
@expect b[1] => 3
@expect b[2] => 0

@test copyarr with start index in string array
@src
$a[0] = "aa" & $a[1] = "bb" & $a[2] = "cc"
@run
@exec copyarr 'b', 'a', 1
@expect $b[0] => 'bb'
@expect $b[1] => 'cc'
@expect $b[2] => ''

@test copyarr with count in numeric array
@src
a[0] = 1 & a[1] = 2 & a[2] = 3
@run
@exec copyarr 'b', 'a', 1, 1
@expect b[0] => 2
@expect b[1] => 0
@expect b[2] => 0

@test copyarr with count in string array
@src
$a[0] = "aa" & $a[1] = "bb" & $a[2] = "cc"
@run
@exec copyarr 'b', 'a', 1, 1
@expect $b[0] => 'bb'
@expect $b[1] => ''
@expect $b[2] => ''

@test copyarr on number array copies string values
@src
a[0] = 1 & $a[1] = 'a' & a[2] = 3
@run
@exec copyarr 'b', 'a'
@expect b[0] => 1
@expect $b[1] => 'a'
@expect b[2] => 3

@test ARRSIZE: return array size
@src
$a[0] = "aa" & $a[1] = "bb" & $a[2] = "cc" & s = arrsize('a')
@run
@expect s => 3

@test ARRSIZE: return array size with mixed values
@src
a[] = 1 & $a[] = "aa" & a[] = 3 & s = arrsize('$a')
@run
@expect s => 3

@test ARRPOS: return index when found for numbers
@src
mass[0]=1 & mass[1]=2 & mass[2]=4 & r = arrpos('mass',2)
@run
@expect r => 1

@test ARRPOS: return index when found for strings
@src
$mass[0]="aa" & $mass[1]="bb" & $mass[2]="cc" & r = arrpos('$mass',"bb")
@run
@expect r => 1

@test ARRPOS: return index for mixed items when found for numbers
@src
$mass[0]='aa' & mass[1]=2 & $mass[2]='xx' & mass[4]=5 & r = arrpos('mass',5)
@run
@expect r => 4

@test ARRPOS: return index for mixed items when found for strings
@src
$mass[0]='aa' & mass[1]=2 & $mass[2]='xx' & mass[4]=5 & r = arrpos('$mass','xx')
@run
@expect r => 2

@test ARRPOS: supports holes
@src
mass[0]=1 & mass[2]=2 & mass[4]=6 & r = arrpos('mass',6)
@run
@expect r => 4

@test ARRPOS: return index including empty elements for numbers
@src
mass[0]=1 & mass[2]=2 & r = arrpos('mass',0)
@run
@expect r => 1

@test ARRPOS: return index including empty elements for strings
@src
$mass[0]='sdsd' & $mass[2]='qq' & r = arrpos('$mass','')
@run
@expect r => 1

@test ARRPOS: return index skipping several elements for numbers
@src
mass[0]=1 & mass[1]=2 & mass[2]=4 & mass[3]=2 & r = arrpos(2,'mass',2)
@run
@expect r => 3

@test ARRPOS: return index skipping several elements for strings
@src
$mass[0]="aa" & $mass[1]="bb" & $mass[3]="bb" & r = arrpos(2,'$mass',"bb")
@run
@expect r => 3

@test ARRPOS: return -1 when not found for numbers
@src
mass[0]=1 & mass[1]=2 & mass[2]=4 & r = arrpos('mass',10)
@run
@expect r => -1

@test ARRPOS: return -1 when not found for strings
@src
$mass[0]="aa" & $mass[1]="bb" & $mass[3]="bb" & r = arrpos('$mass',"zz")
@run
@expect r => -1

// qsp-legacy also checks the position right after the last item, which has the default value
@test ARRPOS: search for 0 finds the position after the last item
@src
mass[0]=1 & mass[1]=2 & mass[2]=1 & r = arrpos('mass',0)
@run
@expect r => 3

// qsp-legacy also checks the position right after the last item, which has the default value
@test ARRPOS: string search for empty string finds the position after the last item
@src
$mass[0]='a' & $mass[1]='b' & $mass[2]='c' & r = arrpos('$mass','')
@run
@expect r => 3

@test ARRCOMP: finds index by regexp
@src
$a[0] = 'a1' & $a[1] = 'b1' & $a[2] = 'c1' & r = arrcomp('$a', 'b\d')
@run
@expect r => 1

@test ARRCOMP: returns -1 when not found
@src
$a[0] = 'a1' & $a[1] = 'b1' & $a[2] = 'c1' & r = arrcomp('$a', 'f\d')
@run
@expect r => -1

@test ARRCOMP: includes empty elements
@src
$a[0] = 'a1' & $a[2] = 'c1' & r = arrcomp('$a', '')
@run
@expect r => 1

@test ARRCOMP: can skip elements
@src
$a[0] = 'a1' & $a[1] = 'b1' & $a[2] = 'a1' & r = arrcomp(1, '$a', 'a\d')
@run
@expect r => 2

@test ARRCOMP: supports holes
@src
$a[0] = 'a1' & $a[2] = 'c1' & $a[4] = 'b1' & r = arrcomp('$a', 'b\d')
@run
@expect r => 4

@test ARRCOMP: finding element by regexp
@src

          $mass[0] = "топаю вперёд"
          $mass[1] = " иду в пещеру"
          $mass[2] = "не иду в пещеру"
          $mass[3] = "топаю к дому"
          res = arrcomp('$mass', '\s?\S+\s\S+\s\S+\s?')

@run
@expect res => 1

@test ARRCOMP: finding element by regexp with skip
@src

          $mass[0] = "топаю вперёд"
          $mass[1] = " иду в пещеру"
          $mass[2] = "не иду в пещеру"
          $mass[3] = "топаю к дому"
          res = arrcomp(2, '$mass', '\s?\S+\s\S+\s\S+\s?')

@run
@expect res => 3

@test ARRCOMP: return -1 for empty array
@src
res = arrcomp('$mass', 'ab')
@run
@expect res => -1


// Ported from qsp-wasm-engine tests/engine/acts.test.ts
// Panels: 0 - actions, 1 - objects, 2 - stats, 3 - user input

@test SHOWACTS should toggle acts visibility
@src
SHOWACTS 0
@run
@expect event panel_visibility 0 0
@exec SHOWACTS 1
@expect event panel_visibility 0 1

@test single line ACT
@src
act '1': p 1
@run
@expect event actions_changed [1]

@test single line ACT with image
@src
act '1', '1.png': p 1
@run
@expect event actions_changed [1|1.png]

@test multi line ACT
@src
act '1':
  p 1
end
@run
@expect event actions_changed [1]

@test multi line ACT with image
@src
act '1', '1.png':
  p 1
end
@run
@expect event actions_changed [1|1.png]

@test ACTs with same name are ignored
@src
act '1': p 1
@run
@expect event actions_changed [1]
@clear-events
@exec act '1': p 1
@expect no-event actions_changed

@test executing action
@src
act '1': p 'a'
@run
@select-act 0
@exec-act
@expect event stats_changed a

@test DELACT should delete action
@src
act '1': p 1
@run
@expect event actions_changed [1]
@clear-events
@exec DELACT '1'
@expect event actions_changed []

@test DEL ACT should delete action
@src
act '1': p 1
@run
@expect event actions_changed [1]
@clear-events
@exec DEL ACT '1'
@expect event actions_changed []

// qsp-legacy keeps the code of actions as it's written instead of converting it to upper case
@test $CURACTS should return acts list as code
@src

act '1': p '1'
act '2':
  p '2'
  p '3'
end
p $CURACTS

@run
@expect event stats_changed ACT '1': p '1'\r\nACT '2':\r\np '2'\r\np '3'\r\nEND\r\n

@test actions can be restored from CURACTS
@src

      act '1': p 'a'
act '2':
  p 'b'
  p 'c'
end
$acts = $CURACTS
@run
@expect event actions_changed [1; 2]
@clear-events
@exec CLA
@expect event actions_changed []
@clear-events
@exec dynamic $acts
@expect event actions_changed [1; 2]

@test $SELACT should return currently selected action
@src
act '1': p 1
@run
@select-act 0
@exec $selected = $SELACT
@expect $selected => '1'

@test CLA should clear list of actions
@src
act '1': p 1
@run
@expect event actions_changed [1]
@clear-events
@exec CLA
@expect event actions_changed []

@test CLS should clear list of actions
@src
act '1': p 1
@run
@expect event actions_changed [1]
@clear-events
@exec CLS
@expect event actions_changed []

// In qsp-legacy a comment after the colon makes a single line action with the comment as its
// code, so the following lines run right away and END is just skipped
@test single line act with a comment
@src

x = 1
act 'test': ! test comment
  x = 2
end

@run
@expect x => 2
@expect acts [test]
@exec x = 3
@select-act 0
@exec-act
@expect x => 3

@test multiline act requires colon
@src

        act 'test'
        end

@run
@expect error COLONNOTFOUND (location 'test', line 2, action -1)
